library(dplyr)
library(ggplot2)
#setwd("C:/Users/jilly/Box/Wetland_Permit_Mapping/Corps_AJD_Data/Clean_Point_Data")
setwd("C:/Users/Chels/Box/Jeff Matthews Lab/Wetland_Permit_Mapping/Corps_AJD_Data/Clean_Point_Data")
ajd_df = read.csv("AJD_Palustrine_Riverine_Reviewed.csv")
ajd_df$Database_YN = (ajd_df$AJD.Forrm.Available..Y.N. == "Yes")
ajd_df$Ones = 1
ajd_df_summary = ajd_df %>%
group_by(Cowardin.Category) %>%
summarize(total_in_database = sum(Database_YN),
total_not_in_database = sum(Ones) - sum(Database_YN))
ajd_df_summary
ajd_df_database = subset(ajd_df, Database_YN == 1)
ajd_df_pal = subset(ajd_df_database, Cowardin.Category == "Palustrine")
ajd_df_riv = subset(ajd_df_database, Cowardin.Category == "Riverine")
ajd_df_pal_area_reported = subset(ajd_df_pal, Wetland.area..ac. != "")
ajd_df_pal_area_reported$wetland_area_numeric = as.numeric(ajd_df_pal_area_reported$Wetland.area..ac.)
ajd_df_pal_area_sum = ajd_df_pal_area_reported %>%
group_by(Reported.JD.Basis, Project.ID, WOTUS) %>%
summarize(total_wetland_area = sum(wetland_area_numeric))
ajd_df_pal_area_sum
