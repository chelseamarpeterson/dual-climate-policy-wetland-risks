library(readxl)
library(dplyr)
# read in data files
d = read_excel("Model_masterlist.xlsx")
counties = read.csv("IL_County_records_new.csv")
View(d)
View(counties)
# subset master list for IL
d.IL = subset(d[,c(1,5,7)])
d.IL = d.IL[-which(d.IL$IL_CC == "NA"),]
View(d.IL)
# isolate wetland species
d.IL.wet = subset(d.IL, d.IL$WV=="FAC" | d.IL$WV=="FACW" | d.IL$WV=="OBL")
# merge species and county dta
d.IL.wet.cnty = merge(counties, d.IL.wet, by="Spp.")
# check for NAs
sum(is.na(d.IL.wet.cnty$WV))
sum(is.na(d.IL.wet.cnty$IL_CC))
# identify unique species
county.spp = data.frame(unique(counties$Spp.))
names(county.spp)[1] = "Spp."
# mismatches (fix these manually)
potential.mismatches = anti_join(d.IL.wet, county.spp, by="Spp.")
View(potential.mismatches)
View(potential.mismatches)
# mismatches (fix these manually)
potential.mismatches = anti_join(county.spp, d.IL.wet, by="Spp.")
# mismatches (fix these manually)
potential.mismatches = anti_join(d.IL.wet, county.spp, by="Spp.")
# mismatches (fix these manually)
potential.mismatches1 = anti_join(d.IL.wet, county.spp, by="Spp.")
potential.mismatches2 = anti_join(county.spp, d.IL.wet, by="Spp.")
View(potential.mismatches2)
potential.mismatches2 = sort(unique(anti_join(county.spp, d.IL.wet, by="Spp.")))
potential.mismatches2 = sort(unique(as.vector(anti_join(county.spp, d.IL.wet, by="Spp."))))
as.vector(anti_join(county.spp, d.IL.wet, by="Spp.")
anti_join(county.spp, d.IL.wet, by="Spp.")
View(potential.mismatches1)
View(potential.mismatches2)
remove(potential.mismatches1)
remove(potential.mismatches2)
View(potential.mismatches)
write.csv(potential.mismatches, "taxonomy.mismatches.csv", row.names=F)
View(potential.mismatches)
View(county.spp)
